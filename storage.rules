rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // KYC Identity Documents: Accessible to authenticated users and escrow platform admins
    match /kyc/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Escrow Dispute Evidence: Unboxing videos, screenshots, transaction proofs
    match /disputes/{escrowId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Default rule: Require authentication
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
